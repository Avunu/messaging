{
	"compilerOptions": {
		"target": "ES2020",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ES2020", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "preserve",
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true,
		"types": ["vite/client", "node", "frappe-types/global"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["messaging/public/js/*"],
			"@vendor-chat/*": ["vendor/vue-advanced-chat/src/*"],
			"frappe-ui": ["messaging/public/js/chat/types/frappe-ui.d.ts"]
		}
	},
	"include": [
		"messaging/public/js/**/*.ts",
		"messaging/public/js/**/*.vue",
		"types/*.d.ts",
		"vite.config.ts"
	],
	"exclude": ["node_modules"]
}
