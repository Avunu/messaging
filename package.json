{
	"name": "messaging",
	"version": "0.0.1",
	"private": true,
	"description": "Messaging app for Frappe with chat-like interface for Communications",
	"license": "MIT",
	"author": "Avunu LLC",
	"type": "module",
	"scripts": {
		"build": "vite build && node scripts/vite-register.mjs",
		"watch": "vite build --watch",
		"dev": "vite build --watch",
		"postinstall": "echo 'Run yarn build to compile assets'",
		"upgrade:interactive": "yarn upgrade-interactive --latest",
		"upgrade:npx": "npx npm-check-updates -u && yarn install",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"typecheck": "tsc --build tsconfig.solution.json && node scripts/vue-tsc.cjs --noEmit -p tsconfig.json",
		"lint:py": "uv run --frozen --project tools ruff check . && uv run --frozen --project tools ruff format --check .",
		"typecheck:py": "uv run --frozen --project tools ty check --python \"${FRAPPE_BENCH_ROOT:-.frappe-nix/bench}/env\"",
		"check": "yarn -s format:check && yarn -s lint && yarn -s typecheck"
	},
	"dependencies": {
		"frappe-ui": "^0.1.262",
		"vue": "^3.5.44",
		"vue-advanced-chat": "^2.1.2"
	},
	"devDependencies": {
		"@iconify-json/lucide": "^1.2.147",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/nesting": "0.0.0-insiders.565cd3e",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^26.6.4",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/compiler-sfc": "^3.5.27",
		"autoprefixer": "^10",
		"cssnano": "^7",
		"frappe-types": "^16.5.0",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"postcss": "^8",
		"postcss-prefix-selector": "^2",
		"sass": "^1.106.1",
		"tailwindcss": "^3.4",
		"typescript": "^7.0.2",
		"typescript5": "npm:typescript@^5.9.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^7.3.1",
		"vue-router": "^5.4.0",
		"vue-tsc": "^3.3.13"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "yarn@1.22.22",
	"frappe": {
		"major": "16",
		"branch": "version-16"
	}
}
